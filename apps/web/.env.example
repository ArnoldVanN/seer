# Copy to .env.local for `pnpm dev`. Ports match apps/server's dev script.
SEER_PUBLIC_API_URL=http://localhost:18080
SEER_PRIVATE_API_URL=http://localhost:18081
# Must match server.internalJwtSecret in the server config.
SEER_INTERNAL_JWT_SECRET=dev-internal-secret
SEER_SESSION_SECRET=dev-session-secret

SEER_PRIVATE_PATH_PREFIX=/internal
# SEER_FORCE_HTTPS=true

# Sign-in. Set OIDC, the admin account, or both.
# SEER_OIDC_ISSUER=https://auth.example.com
# SEER_OIDC_CLIENT_ID=seer
# SEER_OIDC_CLIENT_SECRET=
# SEER_OIDC_GROUPS_CLAIM=groups
# SEER_OIDC_ALLOWED_GROUPS=sre,admin
# SEER_OIDC_ALLOWED_DOMAINS=acme.com
SEER_ADMIN_USERNAME=admin
# Or SEER_ADMIN_PASSWORD_HASH (escape each $ as \$).
SEER_ADMIN_PASSWORD=admin
SEER_ADMIN_GROUPS=admin,sre
